APP_PORT=8190
APP_ENV=development
GIT_SHA=local

# PostgreSQL — shared dev DB (vh-dev-db) or standalone
PGHOST=localhost
PGPORT=5435
PGUSER=user
PGPASSWORD=password
PGDATABASE=accounting
# Test DB defaults to ${PGDATABASE}_test (accounting_test). Override with PGDATABASE_TEST=
# PGDATABASE_TEST=accounting_test

# Keycloak — same client as orders service
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# QuickBooks — from developer.intuit.com
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
QB_REDIRECT_URI=http://localhost:8190/v1/quickbooks/auth/callback
# AES-256 key for encrypting OAuth tokens at rest (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QB_TOKEN_ENCRYPTION_KEY=

# Europe — Customer Payment Totals API (kabbalah.academy billing)
# Base + locale prefix; the client appends /billing/api/customer/payment-totals/.
# The /en prefix is required: the bare host 302-redirects to the locale path, and a
# redirected POST would be downgraded to GET (→ 405). See src/europe/paymentTotalsClient.ts.
EUROPE_API_BASE_URL=https://kabbalah.academy/en
# Application secret — sent as "Authorization: Token <value>". Store securely; never commit a real token.
EUROPE_API_TOKEN=

# Sentry (optional in dev)
SENTRY_DSN=
